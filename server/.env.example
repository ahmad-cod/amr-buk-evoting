# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
# Local:  mongodb://127.0.0.1:27017/amr_buk_evoting
# Atlas:  mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/amr_buk_evoting
# NOTE: Vote recording uses MongoDB transactions, which require a replica set.
# A single-node local mongod started with --replSet works. Atlas works out of the box.
MONGODB_URI=mongodb://127.0.0.1:27017/amr_buk_evoting?replicaSet=rs0

# ---- Auth ----
# Generate a strong secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Days the auth cookie lives (should match JWT_EXPIRES_IN)
COOKIE_MAX_AGE_DAYS=7

# ---- CORS / Client ----
CLIENT_URL=http://localhost:5173

# ---- Supabase Storage (candidate photos) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_NAME=candidate-photos

# ---- Initial Super Admin (used by seed:admin) ----
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=

# ---- Rate limiting (requests per window) ----
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_GENERAL=300
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_VOTE=20
