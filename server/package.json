{
  "name": "amr-buk-evoting-server",
  "version": "1.0.0",
  "description": "Secure e-voting backend for AMR Club BUK — Antimicrobial Resistance Independent Electoral Committee (AMR IEC)",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed:admin": "tsx src/scripts/seedAdmin.ts",
    "seed:demo": "tsx src/scripts/seedDemo.ts",
    "verify": "tsx src/scripts/verifyE2E.ts",
    "verify:roster": "tsx src/scripts/verifyRosterPipeline.ts",
    "verify:photos": "tsx src/scripts/verifyPhase20.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "evoting",
    "election",
    "nacos",
    "buk"
  ],
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.3",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^3.3.7",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.14",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
}
